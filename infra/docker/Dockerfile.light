# Lambda image for light stages: structure, match, sweeper.
# No Tesseract, no torch. Base Python + shared pipeline deps only.
# Build context = repo root: docker build -f infra/docker/Dockerfile.light .
FROM public.ecr.aws/lambda/python:3.12

RUN dnf install -y glib2 \
    && dnf clean all

WORKDIR /var/task

# Install deps into the SYSTEM Python. The Lambda runtime client invokes the
# handler with /var/lang/bin/python, NOT a uv/.venv — installing into a venv
# (the old `uv sync` approach) made the handler fail with ModuleNotFoundError
# at runtime. requirements.txt is generated from pyproject.toml (base, no ml).
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY shared/ shared/
COPY nas/ nas/
COPY cloud/ cloud/

# CMD is overridden per-function in Terraform via image_config.command:
#   structure: cloud.structure.consumer.handler
#   match:     cloud.match.consumer.handler
#   sweeper:   cloud.orchestration.sweeper.handler
CMD ["cloud.structure.consumer.handler"]
