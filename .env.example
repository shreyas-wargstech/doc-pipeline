# Postgres
DATABASE_URL=postgresql+asyncpg://pipeline:pipeline@localhost:5432/doc_pipeline

# S3 (MinIO for local dev — leave S3_ENDPOINT_URL blank for real AWS)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
S3_REGION=us-east-1

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=document_pages
# Embedding model for page vectors (locked — changing requires full re-embed)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pipeline-dev

# OCR
OCR_CONFIDENCE_THRESHOLD=70

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# SQS — local dev uses elasticmq (docker-compose). The queue URL format is
# elasticmq's default (account 000000000000). If `make init` logs a different
# QueueUrl, copy it here.
SQS_OCR_QUEUE_URL=http://localhost:9324/000000000000/ocr-queue.fifo
AWS_REGION=ap-south-1
SQS_ENDPOINT_URL=http://localhost:9324
SQS_STRUCTURE_QUEUE_URL=
SQS_MATCH_QUEUE_URL=
SQS_PERSIST_QUEUE_URL=

# Index stage (chain from persist)
SQS_INDEX_QUEUE_URL=http://localhost:9324/000000000000/index-queue.fifo

# Index keyword extraction mode: llm | tfidf | llm_with_tfidf_fallback
INDEX_KEYWORD_MODE=llm_with_tfidf_fallback

# Retrieval cascade: minimum results before trying next tier
RETRIEVAL_MIN_RESULTS=3

# botocore signs SQS requests with these — elasticmq accepts any value, but
# they MUST be present in the environment of `make serve` / `make ocr-worker`.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# OpenRouter (cloud OCR tier — VLM via OpenAI-compatible gateway)
# OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Vision model: used by VlmTier (handwriting OCR) and VlmPageTyper (image classify). Paid.
OPENROUTER_MODEL=google/gemini-2.5-flash
# Text-only model: used by classifier LLM and structure LLM. openrouter/free auto-selects a working free model.
OPENROUTER_TEXT_MODEL=openrouter/free

# Structure stage — max raw_text chars sent to the extraction LLM
STRUCTURE_MAX_CHARS=6000

# Dashboard session cookie signing secret. MUST be set to a long random value
# in any shared/production deployment. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-insecure-change-me
