# Build context for the `api` image (cloud/Dockerfile, context = repo root).
# Exclude everything the Python/cloud build does not need — this is what
# bloats the context and slows `docker compose build`.

# VCS + local virtualenv
.git/
.venv/

# Claude Code agent state — agent worktrees hold a full repo copy (~1.2 GB);
# never needed in the image and was the dominant build-context bloat.
.claude/

# SAM build artifacts — duplicates all Lambda sources + dependency layers;
# the API image is built from cloud/Dockerfile, not from these.
**/.aws-sam/

# The web app has its own build (web/Dockerfile); never ship it into the api image
web/
node_modules/

# Python caches / artifacts
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Secrets + local env (api reads .env at runtime via compose env_file, not build)
.env
.env.*

# Docs / tests not needed in the runtime image
docs/
documentation/
tests/
*.md

# Build / coverage / log artifacts
dist/
build/
htmlcov/
.coverage
*.log
